# Porta do serviço e ambiente
PORT=3030
NODE_ENV=production

# OmniRoute AI Gateway (ai.sigapro.com)
AI_GATEWAY_URL=https://ai.gateway.com/v1
AI_GATEWAY_KEY=sua_admin_key_do_omniroute
AI_MODEL=auto/fast

# Stack de Observabilidade (Tempo, Prometheus, Loki - rede interna Docker coolify)
PROMETHEUS_URL=http://prometheus:9090
TEMPO_URL=http://tempo:3200
LOKI_URL=http://loki:3100

# Aplicações Monitoradas
PAYMENTS_GATEWAY_URL=https://payments.example.com
PAYMENTS_GATEWAY_HML_URL=https://hml-payments.example.com
SIGAPRO_API_URL=https://api.example.com
SIGAPRO_APP_URL=https://app.example.com

# Notificações no Telegram
TELEGRAM_BOT_TOKEN=1234567890:AAAAAAAaa-Wasdfghhjkls
TELEGRAM_CHAT_ID=-1001234567890
TELEGRAM_THREAD_ID=123
TELEGRAM_RELEASES_THREAD_ID=284

# Integração Coolify (Deployments 24h e Webhook de Releases)
COOLIFY_API_URL=https://infra.sigapro.com/api/v1
COOLIFY_API_TOKEN=

# Integração GitHub (PR Gatekeeper e PR Preview Comments)
GITHUB_TOKEN=ghp_seu_github_personal_access_token
GITHUB_WEBHOOK_SECRET=

# APIs Google (Search Console & PageSpeed Insights)
# GOOGLE_APPLICATION_CREDENTIALS aceita: caminho do arquivo JSON, JSON raw inline ou string Base64 do JSON da Service Account
GOOGLE_APPLICATION_CREDENTIALS=
# PAGESPEED_API_KEY (ou GOOGLE_API_KEY): Opcional! Se ativou a PageSpeed Insights API no mesmo projeto
# da Service Account (GOOGLE_APPLICATION_CREDENTIALS), o agente reutiliza a mesma conta automaticamente via OAuth2.
PAGESPEED_API_KEY=
GOOGLE_API_KEY=
