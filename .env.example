# Porta do serviço
PORT=3030
NODE_ENV=production

# OmniRoute AI Gateway
AI_GATEWAY_URL=https://ai.gateway.com/v1
AI_GATEWAY_KEY=sua_admin_key_do_omniroute
AI_MODEL=auto/fast

# Stack de Observabilidade (Tempo, Prometheus, Loki)
PROMETHEUS_URL=http://prometheus:9090
TEMPO_URL=http://tempo:3200
LOKI_URL=http://loki:3100

# Notificações no Telegram
TELEGRAM_BOT_TOKEN=1234567890:AAAAAAAaa-Wasdfghhjkls
TELEGRAM_CHAT_ID=-1234567890987
TELEGRAM_THREAD_ID=123
