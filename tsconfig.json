{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "paths": {
      "ai/*": ["./src/ai/*"],
      "cli/*": ["./src/cli/*"],
      "collectors/*": ["./src/collectors/*"],
      "config/*": ["./src/config/*"],
      "notifiers/*": ["./src/notifiers/*"],
      "usecases/*": ["./src/usecases/*"],
      "@/*": ["./src/*"]
    }
  },
  "include": ["src/**/*"]
}
