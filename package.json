{
  "name": "sigapro-sre-agent",
  "version": "1.0.0",
  "description": "Intelligent SRE Copilot leveraging OmniRoute AI Gateway and OpenTelemetry/Prometheus/Tempo telemetry",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc && tsc-alias -f",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "start": "node dist/server.js",
    "digest": "tsx src/cli/digest.ts",
    "analyze": "tsx src/cli/analyze.ts"
  },
  "keywords": [
    "sre",
    "observability",
    "opentelemetry",
    "ai-gateway",
    "prometheus",
    "tempo"
  ],
  "author": "Wilson Junior",
  "license": "ISC",
  "dependencies": {
    "dotenv": "^18.0.9",
    "fastify": "^5.12.7",
    "openai": "^7.45.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "prettier": "^3.9.10",
    "tsc-alias": "^1.9.9",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
